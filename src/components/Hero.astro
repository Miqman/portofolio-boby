---
import { Image } from "astro:assets";
import bgHero from "../assets/images/bg-hero.avif";
import dummyPerson from "../assets/images/dummy-person.png";
import { heroIntro, services, site, socialLinks } from "../data/site";
---

<section
  id="beranda"
  class="hero"
  style={`--hero-bg: url(${bgHero.src})`}
>
  <div class="hero-toning" aria-hidden="true"></div>
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="hero-person-wrap reveal delay-1">
    <Image
      src={dummyPerson}
      alt={`Foto ${site.name}`}
      widths={[480, 720, 960]}
      sizes="(max-width: 1023px) 78vw, 480px"
      class="hero-person"
      loading="eager"
      decoding="async"
    />
  </div>

  <div class="hero-stage">
    <div class="container-page hero-shell">
      <div class="hero-layout">
        <div class="hero-intro reveal-left">
          <p class="hero-greeting">{heroIntro.greeting}</p>
          <h1 class="hero-title">
            <span class="hero-title-line">Boby</span>
            <span class="hero-title-line hero-title-accent">Jaksa Purnama</span>
          </h1>
          <p class="hero-role">{site.profession}</p>
          <p class="hero-bio">{heroIntro.bio}</p>

          <div class="hero-social">
            {
              socialLinks.map((link) => (
                <a
                  href={link.href}
                  target={link.href === "#" ? undefined : "_blank"}
                  rel={link.href === "#" ? undefined : "noopener noreferrer"}
                  aria-label={link.label}
                  class:list={["hero-social-link", { "is-disabled": link.href === "#" }]}
                >
                  <i class={link.icon}></i>
                </a>
              ))
            }
          </div>

          <div class="hero-actions">
            <a href={site.cvUrl} download class="hero-btn hero-btn-primary">
              <i class="ri-download-line"></i>
              Download CV
              <i class="ri-download-line"></i>
            </a>
            <a href="#kontak" class="hero-btn hero-btn-outline">
              <i class="ri-send-plane-line"></i>
              Contact Me
            </a>
          </div>
        </div>

        <div class="hero-aside reveal-right delay-2">
          <p class="hero-aside-quote">
            {heroIntro.asideQuote.map((line, i) => (
              <>
                {i > 0 ? <br /> : null}
                {line}
              </>
            ))}
          </p>
          <span class="hero-aside-quote-line" aria-hidden="true"></span>

          <div class="hero-services-card">
            <ul class="hero-services-list">
              {
                services.map((service) => (
                  <li class="hero-service-row">
                    <span class="hero-service-icon" aria-hidden="true">
                      <i class={service.icon}></i>
                    </span>
                    <span class="hero-service-text">
                      <span class="hero-service-title">{service.title}</span>
                      <span class="hero-service-detail">{service.heroDetail}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
