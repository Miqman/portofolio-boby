---
import { site, socialLinks } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer-bar">
  <div class="container-page footer-bar-inner">
    <a href="#beranda" class="footer-brand">
      <span class="footer-brand-mark">BP</span>
      <span class="footer-brand-text">
        {site.name}
        <span class="footer-brand-sep" aria-hidden="true">|</span>
        {site.portfolioLabel}
      </span>
    </a>

    <div class="footer-meta">
      <p class="footer-copy">© {year} {site.name}. All rights reserved.</p>
      <div class="footer-social">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target={link.href === "#" ? undefined : "_blank"}
              rel={link.href === "#" ? undefined : "noopener"}
              aria-label={link.label}
              class:list={[{ "pointer-events-none opacity-40": link.href === "#" }]}
            >
              <i class={link.icon}></i>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<button
  id="backTop"
  class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full bg-brand-500 text-white shadow-xl shadow-blue-900/20 grid place-items-center hover:bg-brand-600 transition-colors"
  aria-label="Kembali ke atas"
>
  <i class="ri-arrow-up-line text-lg"></i>
</button>
