---
import { portfolio } from "../data/site";
---

<section id="portofolio" class="section bg-[var(--page)]">
  <div class="container-page">
    <div class="reveal">
      <p class="section-label">Portofolio</p>
      <h2 class="section-title">Proyek & Pekerjaan Terpilih</h2>
      <p class="section-desc">
        Cuplikan layanan nyata yang sering saya tangani — ganti detail dan foto sesuai
        dokumentasi Anda.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-5 reveal delay-1">
      {
        portfolio.map((item) => (
          <article class="portfolio-card">
            <div class="portfolio-card-media">
              <img src={item.image} alt={item.title} loading="lazy" />
            </div>
            <div class="portfolio-card-body">
              <h3 class="font-bold text-sm text-[#10243b]">{item.title}</h3>
              <p class="mt-2 text-xs text-slate-500 leading-6">{item.description}</p>
              <p class="mt-3 text-[.65rem] font-semibold text-brand-600">
                Peran: {item.role}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
