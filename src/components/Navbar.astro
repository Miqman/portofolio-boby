---
import { navLinks } from "../data/site";
import Logo from "./Logo.astro";
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50">
  <div class="container-page">
    <div class="navbar-row flex items-center justify-between">
      <Logo />

      <nav class="hidden md:flex items-center gap-9">
        {
          navLinks.map((link, i) => (
            <a class:list={["nav-link", { active: i === 0 }]} href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>

      <a
        href="#kontak"
        class="btn-primary hidden md:inline-flex text-[0.68rem] shadow-lg shadow-blue-900/20 hover:bg-brand-600 hover:-translate-y-0.5"
      >
        <i class="ri-phone-fill text-[15px]"></i>
        Hubungi Kami
      </a>

      <button id="menuButton" class="md:hidden text-white p-2" aria-label="Buka menu">
        <i class="ri-menu-line text-2xl"></i>
      </button>
    </div>

    <div id="mobileMenu" class="md:hidden max-h-0 opacity-0 overflow-hidden">
      <nav
        class="rounded-2xl mb-3 bg-[#061a31]/95 backdrop-blur-xl border border-white/10 p-4 flex flex-col gap-1"
      >
        {
          navLinks.map((link) => (
            <a
              class="mobile-link px-4 py-3 rounded-xl text-white/80 hover:bg-white/10"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
