---
import { Image } from "astro:assets";
import { certificates, skillsModalIntro } from "../data/site";
import sertifBob1 from "../assets/images/sertif-bob-1.avif";

const titleId = "modal-title-skills";

const certImages = {
  "sertif-bob-1": sertifBob1,
} as const;
---

<input type="radio" name="skills-modal" id="modal-skills-detail" class="modal-toggle" />
<div class="service-modal" role="dialog" aria-labelledby={titleId}>
  <label for="modal-skills-close" class="modal-backdrop" aria-label="Tutup dialog"></label>
  <div class="modal-panel modal-panel-certs">
    <div class="modal-glow"></div>
    <div class="modal-header modal-header-compact">
      <label for="modal-skills-close" class="modal-close" aria-label="Tutup">
        <i class="ri-close-line"></i>
      </label>
      <div class="modal-icon-float">
        <i class="ri-award-line"></i>
      </div>
    </div>
    <div class="modal-body modal-body-scroll modal-body-certs">
      <div class="cert-modal-inner">
        <span class="modal-badge"><i class="ri-award-line"></i> {skillsModalIntro.badge}</span>
        <h3 id={titleId} class="modal-title">{skillsModalIntro.title}</h3>
        <p class="modal-subtitle">{skillsModalIntro.description}</p>

        <ul class="cert-modal-list mt-4">
          {
            certificates.map((cert) => (
              <li class="cert-modal-item">
                <a
                  class="cert-modal-media"
                  href={certImages[cert.image].src}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Image
                    src={certImages[cert.image]}
                    alt={cert.title}
                    widths={[240, 480, 720]}
                    sizes="(max-width: 479px) 100vw, (max-width: 719px) 50vw, 220px"
                    class="cert-modal-img"
                  />
                  <span class="cert-modal-zoom" aria-hidden="true">
                    <i class="ri-zoom-in-line"></i>
                  </span>
                </a>
                <div class="cert-modal-caption">
                  <p class="cert-modal-title">{cert.title}</p>
                  {cert.issuer ? <p class="cert-modal-meta">{cert.issuer}</p> : null}
                  {cert.period ? <p class="cert-modal-meta">{cert.period}</p> : null}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="modal-footer">
        <label for="modal-skills-close" class="modal-btn modal-btn-secondary">
          <i class="ri-close-circle-line"></i> Tutup
        </label>
      </div>
    </div>
  </div>
</div>
