---
import {
  aboutDetails,
  aboutIntro,
  aboutStats,
  site,
} from "../data/site";
---

<section id="tentang" class="section bg-white">
  <div class="container-page about-layout">
    <div class="about-body">
      <figure class="about-photo about-photo-frame reveal-left">
        <img
          src={site.aboutPhoto}
          alt={`Foto ${site.name}`}
          width="560"
          height="700"
          loading="lazy"
          decoding="async"
          class="about-photo-img"
        />
        <figcaption class="about-photo-quote">
          <em>
            {aboutIntro.quoteLines.map((line, i) => (
              <>
                {i > 0 ? <br /> : null}
                {line}
              </>
            ))}
          </em>
          <span class="about-photo-quote-line" aria-hidden="true"></span>
        </figcaption>
      </figure>

      <div class="about-main reveal">
        <p class="section-label">{aboutIntro.label}</p>
        <h2 class="section-title">{site.name}</h2>
        <p class="about-bio">{aboutIntro.bio}</p>

        <ul class="about-details">
          {
            aboutDetails.map((item) => (
              <li class="about-detail-row">
                <span class="about-detail-icon" aria-hidden="true">
                  <i class={item.icon}></i>
                </span>
                <span class="about-detail-text">
                  <span class="about-detail-label">{item.label}</span>
                  {item.label === "Email" ? (
                    <a class="about-detail-value" href={`mailto:${item.value}`}>
                      {item.value}
                    </a>
                  ) : (
                    <span class="about-detail-value">{item.value}</span>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="about-stats-panel reveal-right delay-2">
      {
        aboutStats.map((stat) => (
          <div class:list={["about-stat-row", { "about-stat-row-accent": stat.accent }]}>
            <span class="about-stat-icon" aria-hidden="true">
              <i class={stat.icon}></i>
            </span>
            <div class="about-stat-body">
              <p class:list={["about-stat-value", { "is-accent": stat.accent }]}>{stat.value}</p>
              <p class="about-stat-title">{stat.title}</p>
              <p class="about-stat-subtitle">{stat.subtitle}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
