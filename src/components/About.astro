---
import { aboutStats } from "../data/site";
import InfoColumn from "./InfoColumn.astro";
---

<section id="tentang" class="section bg-white">
  <div class="container-page">
    <div class="reveal">
      <p class="section-label">Tentang Saya</p>
      <h2 class="section-title">Pengalaman & Kepercayaan Pelanggan</h2>
      <p class="section-desc">
        Saya Boby Jaksa Purnama, bergerak di layanan digital, teknologi, dan kebutuhan
        harian. Fokus saya: proses jelas, harga transparan, dan hasil yang bisa
        diandalkan.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
      {
        aboutStats.map((stat, i) => (
          <div class={`stat-card reveal delay-${i + 1}`}>
            <p class="stat-card-value">{stat.value}</p>
            <p class="stat-card-label">{stat.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 grid md:grid-cols-2 gap-8 md:gap-12">
      <InfoColumn icon="ri-user-3-line" title="Ringkasan" class="px-0 reveal-left">
        <p class="mt-4 text-sm text-slate-500 leading-7">
          Dari servis HP, PPOB, rental mobil, maintenance listrik, hingga langganan
          aplikasi premium — saya menjalankan operasional langsung dan mendampingi
          pelanggan dari konsultasi sampai selesai.
        </p>
      </InfoColumn>

      <InfoColumn
        icon="ri-star-fill"
        title="Kenapa Memilih Saya?"
        class="px-0 reveal-right delay-2"
      >
        <ul class="check-list mt-4">
          <li>Pelayanan ramah & profesional</li>
          <li>Harga bersaing dan transparan</li>
          <li>Proses cepat dan mudah</li>
          <li>Bisa online / offline</li>
          <li>Siap membantu kapan saja</li>
        </ul>
      </InfoColumn>
    </div>
  </div>
</section>
