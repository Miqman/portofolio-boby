---
import { promoApps, site } from "../data/site";
---

<section id="produk" class="bg-white pb-16">
  <div class="container-page">
    <div
      class="promo min-h-[125px] px-6 md:px-8 py-6 flex flex-col lg:flex-row items-center justify-between gap-6 reveal"
    >
      <div class="relative z-10 text-center lg:text-left">
        <p class="text-brand-500 font-bold font-heading text-xl md:text-2xl leading-tight">
          Aplikasi Premium<br /><span class="text-white">Hanya 2rb an!</span>
        </p>
        <p class="text-white/65 text-[.62rem] mt-2 max-w-[330px]">
          Nikmati berbagai aplikasi premium favoritmu dengan harga terjangkau dan proses
          cepat!
        </p>
      </div>

      <div class="relative z-10 flex flex-wrap justify-center gap-3">
        {promoApps.map((app) => <span class="app-logo">{app}</span>)}
      </div>

      <div class="relative z-10 shrink-0 text-center">
        <p class="text-white/60 text-[.58rem] mb-2">Order Sekarang!</p>
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full bg-brand-500 hover:bg-brand-600 text-white px-5 py-2.5 text-[.65rem] font-semibold transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/20"
        >
          <span><i class="ri-whatsapp-line"></i></span>
          {site.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>
